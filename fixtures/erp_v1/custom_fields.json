    "options": "EC_TAOBAO\nEC_JD\nEC_PDD\nEC_DOUYIN\nEC_KUAISHOU\nEC_SELF\nEC_MOCK\nOFFLINE_POS\nOFFLINE_DEALER\nOFFLINE_PHONE\nOFFLINE_MOCK",
